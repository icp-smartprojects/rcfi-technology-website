# RCFI website-v2 → rcfi-support connection
# Copy to .env.local

# Support backend (no trailing slash)
SUPPORT_API_URL=http://localhost:7000

# Must match Back-end WEBSITE_CONTACT_SECRET (generate: openssl rand -hex 24)
WEBSITE_CONTACT_SECRET=

# Must match Back-end GATEWAY_INTERNAL_SECRET (production — blocks direct :7000 access)
GATEWAY_INTERNAL_SECRET=

# Support portal — staff login link shown on contact page
NEXT_PUBLIC_SUPPORT_PORTAL_URL=http://localhost:9090
